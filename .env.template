PORT=3000

# Entorno de ejecución: development o production
NODE_ENV=development

# MongoDB
MONGO_URL=mongodb://<db_user>:<db_password>@localhost:27017/?authSource=admin
MONGO_DB_NAME=nombre_de_la_base
# usuario y contraseña con los que Docker crea la base
MONGO_USER=tu_usuario
MONGO_PASSWORD=tu_contraseña

# Semilla con la que se firman los tokens (JWT).
# usa un valor largo y aleatorio
JWT_SEED=cambia_este_valor

# Correo
# proveedor (ej. gmail)
MAILER_SERVICE=gmail
# cuenta desde la que se envían los correos
MAILER_EMAIL=correo@ejemplo.com
# constraseña de aplicación, no la contraseña del correo.
# en gmail se crea en https://myaccount.google.com/apppasswords
# (se necesita la verificación de dos pasos activada)
MAILER_SECRET_KEY=tu_contraseña_de_aplicación
# true para envíar correos. false para simular envío
SEND_EMAIL=false

# URL pública del servidor, usada para construir el enlace de verificación
WEBSERVICE_URL=http://localhost:3000/api